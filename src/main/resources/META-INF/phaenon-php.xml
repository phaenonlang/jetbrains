<!-- Loaded only when the PHP plugin (com.jetbrains.php) is present. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- .phn joins the PHP file type (no implementationClass: this bean only adds an extension). -->
        <fileType name="PHP" extensions="phn"/>

        <!-- Runs ahead of PhpStorm's factory; claims .phn, delegates every other PHP file. -->
        <lang.fileViewProviderFactory language="PHP" order="first"
                                      implementationClass="dev.phaenon.jetbrains.PhaenonFileViewProviderFactory"/>

        <annotator language="PHP" implementationClass="dev.phaenon.jetbrains.PhaenonPhpTagAnnotator"/>

        <!-- PhpStorm's PHP formatter for .phn files, without the HTML layer its template formatter expects.
             A custom builder: the platform asks it only for the contexts it claims, so .php keeps PhpStorm's. -->
        <lang.formatter language="PHP" order="last" implementationClass="dev.phaenon.jetbrains.PhaenonFormattingModelBuilder"/>
        <!-- Reformat Code ends with phn fmt's first layer, run on the text through standard input; a .phn indents with spaces (D21). -->
        <preFormatProcessor implementation="dev.phaenon.jetbrains.PhaenonPreFormatProcessor"/>
        <postFormatProcessor implementation="dev.phaenon.jetbrains.PhaenonPostFormatProcessor"/>
        <fileIndentOptionsProvider implementation="dev.phaenon.jetbrains.PhaenonIndentOptionsProvider" order="first"/>

        <!-- Implement / Override Methods in a .phn class: `fun`, the parent's declared types, its type parameters substituted. -->
        <codeInsight.implementMethod language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonImplementMethodsHandler"/>
        <codeInsight.overrideMethod language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonOverrideMethodsHandler"/>

        <!-- PhpStorm's nested-calls-to-pipe fix writes `Style(...)` for `Style::line(...)`: in .phn files a correct conversion
             replaces it (the fix came after PHP 8.5 support, not in 2025.3, and is matched by class name). -->
        <intentionAction>
            <language>PHP</language>
            <className>dev.phaenon.jetbrains.PhaenonPipeConversionIntention</className>
            <category>Phaenon</category>
        </intentionAction>
        <daemon.intentionActionFilter implementation="dev.phaenon.jetbrains.PhaenonPipeQuickFixFilter"/>

        <!-- `/**` + Enter: PhpStorm's stub without the @param/@return tags a declared (or erased) type makes redundant. -->
        <enterHandlerDelegate implementation="dev.phaenon.jetbrains.PhaenonDocCommentEnterHandler" order="before phpEnterHandler"/>

        <!-- Erased Phaenon types leave `readonly` properties untyped for PhpStorm's annotator; the
             .php compiled from a .phn is not "another declaration" of its classes. -->
        <daemon.highlightInfoFilter implementation="dev.phaenon.jetbrains.PhaenonHighlightFilter"/>

        <!-- Overrides involving an erased type, which PhpStorm's hierarchy check reads as untyped: judged
             with the types the compiler writes, the parent's type parameters substituted (the filter
             drops PhpStorm's own finding on such a pair). -->
        <localInspection language="PHP" shortName="PhaenonHierarchyChecks" displayName="Phaenon override compatibility"
                         groupPath="PHP" groupName="Phaenon" enabledByDefault="true" level="ERROR"
                         implementationClass="dev.phaenon.jetbrains.PhaenonHierarchyInspection"/>

        <!-- Optimize Imports in .phn files: PhpStorm's optimizer, but an import an erased construct uses
             (`list<DomainEvent>`) stays. First: the platform takes the first optimizer that supports a file. -->
        <lang.importOptimizer language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonImportOptimizer"/>

        <!-- Class names inside erased constructs (`list<User>`) are references, complete, and are not prose. -->
        <psi.referenceContributor language="PHP" implementation="dev.phaenon.jetbrains.PhaenonErasedReferenceContributor"/>
        <!-- Before the live-template contributor, which wraps every contributor after it: in .phn files this one drops
             PhpStorm's `fun` live template (a second `fun`, expanding to `function`) and makes override items Phaenon's. -->
        <completion.contributor language="PHP" order="first, before liveTemplates"
                                implementationClass="dev.phaenon.jetbrains.PhaenonErasedCompletionContributor"/>
        <spellchecker.support language="PHP" order="first"
                              implementationClass="dev.phaenon.jetbrains.PhaenonSpellcheckingStrategy"/>

        <!-- Quick documentation, the Ctrl+hover hint and parameter info of Phaenon declarations in Phaenon's spelling
             (`class<T>`, `list<User>`), where PhpStorm prints the erasure. Both come before PhpStorm's and answer only
             for Phaenon elements. -->
        <lang.documentationProvider language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonDocumentationProvider"/>
        <codeInsight.parameterInfo language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonParameterInfoHandler"/>

        <!-- A declaration in a .phn wins over its compiled copy; `@var T` goes to `<T of …>`. -->
        <gotoDeclarationHandler implementation="dev.phaenon.jetbrains.PhaenonGotoDeclarationHandler"/>

        <!-- `T` in `class Box<T of Item>` is a declaration: Cmd+click shows its usages, which include
             erased constructs and docblock types naming it. -->
        <psi.declarationProvider implementation="dev.phaenon.jetbrains.PhaenonTypeParameterDeclarations"/>
        <findUsagesHandlerFactory implementation="dev.phaenon.jetbrains.PhaenonTypeParameterFindUsagesHandlerFactory"/>
        <referencesSearch implementation="dev.phaenon.jetbrains.PhaenonDocTypeReferenceSearcher"/>

        <!-- The stubs of .phn files carry PhpStorm's stub version: after a plugin update that changed
             the PSI they are re-indexed once (PhaenonFileElementType.PSI_VERSION). -->
        <postStartupActivity implementation="dev.phaenon.jetbrains.PhaenonReindexActivity"/>

        <!-- Debugging .phn: PhpStorm's template debugging (Twig, Blade) with the compiled files' line maps —
             breakpoints go to the compiled file at the reverse-mapped line, frames show the .phn. -->
        <php.debug.templateLanguage implementation="dev.phaenon.jetbrains.PhaenonDebugPathMapper"/>
    </extensions>

    <projectListeners>
        <!-- A step that stays on a source line through lines the compiler wrote is repeated. -->
        <listener class="dev.phaenon.jetbrains.PhaenonSourceStepping" topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
    </projectListeners>
    <applicationListeners>
        <listener class="dev.phaenon.jetbrains.PhaenonStepActionListener" topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.jetbrains.php">
        <!-- The editor highlighter is keyed by file type and asks this EP for its lexer. -->
        <baseLexerProvider implementation="dev.phaenon.jetbrains.PhaenonBaseLexerProvider"/>

        <!-- Types for erased Phaenon declarations, partial applications and pipe stages. -->
        <typeProvider4 implementation="dev.phaenon.jetbrains.PhaenonTypeProvider"/>
    </extensions>
</idea-plugin>
