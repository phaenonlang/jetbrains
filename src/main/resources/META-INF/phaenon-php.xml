<!-- Loaded only when the PHP plugin (com.jetbrains.php) is present. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- .phn joins the PHP file type (no implementationClass: this bean only adds an extension). -->
        <fileType name="PHP" extensions="phn"/>

        <!-- Runs ahead of PhpStorm's factory; claims .phn, delegates every other PHP file. -->
        <lang.fileViewProviderFactory language="PHP" order="first"
                                      implementationClass="dev.phaenon.jetbrains.PhaenonFileViewProviderFactory"/>

        <annotator language="PHP" implementationClass="dev.phaenon.jetbrains.PhaenonPhpTagAnnotator"/>

        <!-- Erased Phaenon types leave `readonly` properties untyped for PhpStorm's annotator; the
             .php compiled from a .phn is not "another declaration" of its classes. -->
        <daemon.highlightInfoFilter implementation="dev.phaenon.jetbrains.PhaenonHighlightFilter"/>

        <!-- Overrides involving an erased type, which PhpStorm's hierarchy check reads as untyped: judged
             with the types the compiler writes, the parent's type parameters substituted (the filter
             drops PhpStorm's own finding on such a pair). -->
        <localInspection language="PHP" shortName="PhaenonHierarchyChecks" displayName="Phaenon override compatibility"
                         groupPath="PHP" groupName="Phaenon" enabledByDefault="true" level="ERROR"
                         implementationClass="dev.phaenon.jetbrains.PhaenonHierarchyInspection"/>

        <!-- Optimize Imports in .phn files: PhpStorm's optimizer, but an import an erased construct uses
             (`list<DomainEvent>`) stays. First: the platform takes the first optimizer that supports a file. -->
        <lang.importOptimizer language="PHP" order="first" implementationClass="dev.phaenon.jetbrains.PhaenonImportOptimizer"/>

        <!-- Class names inside erased constructs (`list<User>`) are references, complete, and are not prose. -->
        <psi.referenceContributor language="PHP" implementation="dev.phaenon.jetbrains.PhaenonErasedReferenceContributor"/>
        <completion.contributor language="PHP" order="first"
                                implementationClass="dev.phaenon.jetbrains.PhaenonErasedCompletionContributor"/>
        <spellchecker.support language="PHP" order="first"
                              implementationClass="dev.phaenon.jetbrains.PhaenonSpellcheckingStrategy"/>

        <!-- A declaration in a .phn wins over its compiled copy; `->map` on a list resolves to a
             bundled pseudo-class and navigation prefers \Phaenon\Seq::map; `@var T` goes to `<T of …>`. -->
        <gotoDeclarationHandler implementation="dev.phaenon.jetbrains.PhaenonGotoDeclarationHandler"/>

        <!-- `T` in `class Box<T of Item>` is a declaration: Cmd+click shows its usages, which include
             erased constructs and docblock types naming it. -->
        <psi.declarationProvider implementation="dev.phaenon.jetbrains.PhaenonTypeParameterDeclarations"/>
        <findUsagesHandlerFactory implementation="dev.phaenon.jetbrains.PhaenonTypeParameterFindUsagesHandlerFactory"/>
        <referencesSearch implementation="dev.phaenon.jetbrains.PhaenonDocTypeReferenceSearcher"/>

        <!-- The stubs of .phn files carry PhpStorm's stub version: after a plugin update that changed
             the PSI they are re-indexed once (PhaenonFileElementType.PSI_VERSION). -->
        <postStartupActivity implementation="dev.phaenon.jetbrains.PhaenonReindexActivity"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains.php">
        <!-- The editor highlighter is keyed by file type and asks this EP for its lexer. -->
        <baseLexerProvider implementation="dev.phaenon.jetbrains.PhaenonBaseLexerProvider"/>

        <!-- Types for erased Phaenon declarations; the Str methods on string receivers. -->
        <typeProvider4 implementation="dev.phaenon.jetbrains.PhaenonTypeProvider"/>

        <!-- The editor-only \Phaenon\Internal\*Methods pseudo-classes behind the method syntax. -->
        <libraryRoot id="phaenon" path="stubs/phaenon" runtime="false"/>
    </extensions>
</idea-plugin>
