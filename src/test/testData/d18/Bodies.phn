namespace App;

use App\Errors\NotFound;
use App\Errors\Unavailable;

/** Names and their lengths. */
interface Names
{
    find(int $id): ?string throws NotFound;

    all(): list<string>;
}

trait Greets
{
    greet(string $who): string => 'Hello, ' . $who;
}

enum Level: int
{
    case Low = 1;
    case High = 2;

    label(): string => match ($this) {
        Level::Low => 'low',
        Level::High => 'high',
    };
}

final readonly class Directory implements Names
{
    use Greets;

    /** @param list<string> $names */
    __construct(private array $names) {}

    find(int $id): ?string throws NotFound
        => $this->names[$id] ?? throw new NotFound($id);

    #[\Override]
    all(): list<string> => $this->names;

    count(): int => \count($this->names);

    /** The first name. */
    first(): string throws NotFound|Unavailable => $this->find(0) ?? throw new Unavailable();

    log(string $message): void => $this->write($message);

    /**
     * Fails.
     */
    fail(string $why): never throws \LogicException => throw new \LogicException($why);

    private write(string $message): void {
        echo $message;
    }

    static of(string ...$names): self => new self(array_values($names));
}

function twice(int $x): int => $x * 2;

/** Checks the directory. */
function check(Directory $d): string throws NotFound {
    return $d->find(1) ?? '';
}
