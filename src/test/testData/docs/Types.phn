namespace App;

final class User
{
}

final class Types
{
    run(list<User> $users, map<string, User> $byName, bytes $raw, ?class<User> $maybe, Closure(int): string $format, string $name): void
    {
        $list = $users;
        $map = $byName;
        $bytes = $raw;
        $nullable = $maybe;
        $closure = $format;
        $plain = $name;
    }

    /**
     * @param int $limit - how many
     */
    protected static pick<T of User>(list<T> $from, int $limit = 3, string ...$tags): ?T
    {
        return null;
    }
}

abstract class Legacy
{
    abstract public function named(list<User> $users): ?User;
}

function firstOf<T>(list<T> $xs): ?T
{
    return $xs[0] ?? null;
}
