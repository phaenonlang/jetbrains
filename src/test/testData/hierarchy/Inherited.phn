namespace App;

/** A document mapper's normalizers: a child that writes the parent's erasure natively inherits its types. */
interface Normalizer<PhpType of object, DbType of mixed>
{
    normalize(PhpType $value): DbType;

    denormalize(DbType $value, class<PhpType> $phpType): PhpType;
}

final class Level
{
}

final readonly class LevelNormalizer implements Normalizer<Level, string|int>
{
    normalize(object $value): mixed
    {
        return 1;
    }

    denormalize(mixed $value, string $phpType): object
    {
        return new Level();
    }
}

/** A command bus: `Command<TResult>` erases to `Command`, type argument and all. */
interface Command<TResult>
{
}

interface CommandBus
{
    dispatch<TResult>(Command<TResult> $command, string|map<string, mixed> ...$options): TResult;
}

final class DefaultCommandBus implements CommandBus
{
    dispatch(Command $command, string|array ...$options): mixed
    {
        return null;
    }
}

interface Store<T of object>
{
    insertMany(iterable<T> $documents, map<string, mixed> $options = []): void;
}

abstract class DocumentStore<T of object> implements Store<T>
{
    insertMany(iterable $documents, array $options = []): void
    {
    }
}
