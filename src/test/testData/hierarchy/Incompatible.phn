namespace App;

abstract class StringRepository<Id of AggregateId, T of EventSourcedAggregate> implements AggregateRepository<Id, T>
{
    get(Id $id): ?string
    {
        return null;
    }

    load(Id $id): T
    {
        throw new \LogicException();
    }

    save(string $aggregate): void
    {
    }
}

interface PlainStore
{
    save(Aggregate $aggregate): void;
}

abstract class NarrowerBound<T of EventSourcedAggregate> implements PlainStore
{
    save(T $aggregate): void
    {
    }
}

abstract class RawRepository implements AggregateRepository
{
    get(AggregateId $id): ?Aggregate
    {
        return null;
    }

    load(AggregateId $id): Aggregate
    {
        throw new \LogicException();
    }

    save(EventSourcedAggregate $aggregate): void
    {
    }
}

abstract class MissingParameter<Id of AggregateId, T of Aggregate> implements AggregateRepository<Id, T>
{
    save(): void
    {
    }
}
