namespace App;

use App\Model\ArgOnly;
use App\Model\DocOnly;
use App\Model\Native;
use App\Model\QualifiedSigOnly;
use App\Model\ReturnOnly;
use App\Model\SigOnly;
use App\Model\UnionOnly;

final class Box<T>
{
}

final class Erased
{
    /**
     * @return list<DocOnly>
     */
    docs(): array
    {
        return [];
    }

    of(Native $native, string|list<UnionOnly> $union, Closure(SigOnly): bool $test, \Closure(QualifiedSigOnly): bool $other): list<ReturnOnly>
    {
        $box = new Box<ArgOnly>();

        return [];
    }
}
