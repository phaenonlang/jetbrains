namespace Tequila\Tq\Dev;

/**
 * tq-cli's DevUp: a kubectl runner held as `Closure(string...): (int, string)`, a logger as
 * `Closure(string, int=): void`. The closure literals assigned here are what PhpStorm infers the
 * properties from as well, and it encodes the literal's variadic as `string[]`.
 */
final class DevUp
{
    private Closure(string...): (int, string) $kubectl;
    private Closure(string, int=): void $log;
    private Closure(string...): bool $accept;
    private Closure(string...): void $say;
    private Closure(string, string...): (int, string) $kubectlStdin;

    fun __construct(
        ?Closure(string...): (int, string) $kubectl = null,
        ?Closure(string, int=): void $log = null,
    ) {
        $this->kubectl = $kubectl ?? static fn (string ...$args): array => [0, ''];
        $this->log = $log ?? static fn (string $line, int $level = 0) => null;
        $this->accept = static fn (string ...$names): bool => true;
        $this->say = static fn (string ...$lines) => null;
        $this->kubectlStdin = static fn (string $stdin, string ...$args): array => [0, ''];
    }

    fun ensureNamespace(string $ns): int
    {
        [$code] = ($this->kubectl)('get', 'namespace', $ns);
        ($this->log)('checked');
        ($this->log)('checked', 1);
        ($this->accept)('a', 'b');
        ($this->say)('a', 'b', 'c');
        ($this->kubectlStdin)('manifest', 'apply', '-f', '-');

        return $code;
    }

    fun wrong(): void
    {
        ($this->kubectl)([]);
        ($this->log)('checked', []);
    }

    static fun first(Closure(string...): (int, string) $kubectl): int
    {
        [$status] = $kubectl('get', 'namespace');

        return $status;
    }
}
