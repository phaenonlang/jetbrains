namespace App;

fun format(int $count, string $unit = 'items', string ...$tags): string {
    return $count . $unit;
}

final class Calc
{
    const ROUNDED = Calc::round(?, 2);

    public static fun round(float $value, int $precision): float {
        return $value;
    }

    fun scale(int $by, float $value): float {
        return $value * $by;
    }
}

final class Partials
{
    fun __construct(private \Closure $formatter = format(?, 'pcs')) {
    }

    fun run(Calc $calc): void {
        $positional = format(?, 'kg');
        $rest = format(3, ...);
        $named = format(unit: ?, count: 1);
        $method = $calc->scale(2, ?);
        $static = Calc::round(?, 0);
        $called = $positional(5);
    }
}

const FORMAT = format(?, 'm');
