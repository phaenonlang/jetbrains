namespace App;

function label(string $prefix, string $value): string {
    return $prefix . $value;
}

function frame(string $open, string $body, string $close): string {
    return $open . $body . $close;
}

function take(\Closure $c): int {
    return 1;
}

final class Meter
{
    public static clamp(float $value, float $low, float $high): float {
        return $value;
    }

    scale(int $by, float $value): float {
        return $value * $by;
    }
}

final class Box
{
    __construct(int $a, int $b) {}
}

final class Missing
{
    /** @param list<string> $args */
    run(Meter $meter, string $ns, float $ratio, array $args): void {
        $call = label('✓ ');
        $calls = frame('[');
        $placeholder = label(?);
        $notLast = label(..., value: 'x');
        $new = new Box(1, ...);
        $outer = take();
        $around = label(take(label('✓ ', ...)));
        $reverse = frame(label('◦ '), ...);
        $twoLeft = $ns |> frame('(', ...);
        $staticTwoLeft = $ratio |> Meter::clamp(1.0, ...);
        $placeholderStage = $ns |> label(prefix: ?, ...);
        $methodPlaceholderStage = 2 |> $meter->scale(?, ...);
        $nullsafe = $meter?->scale(3, ...);
        $invokedEmpty = label('◇ ', ...)();
        $invokedShort = frame('{', ...)('x');
        $invokedNamed = frame('«', ...)(close: '»');
        $unpacked = label(...$args, value: 'x', ...);
    }
}
