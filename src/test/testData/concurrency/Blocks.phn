namespace App;

use Phaenon\Concurrent\Scope;

final class ApiException extends \Exception
{
}

final class User
{
    public string $name = '';
}

final class Users
{
    fun find(int $id): User {
        $user = new User();
        $user->name = 'user ' . $id;

        return $user;
    }

    fun exists(string $name): bool {
        return $name !== '';
    }
}

final class Blocks
{
    fun __construct(private Users $users) {}

    /**
     * tq-cli's CiIdentityCommand: a block as a value, a block task per name.
     *
     * @param list<string> $names
     * @return list<string>
     */
    fun existing(array $names, string $org): array {
        $exists = concurrently {
            $tasks = [];
            foreach ($names as $name) {
                $tasks[$name] = spawn {
                    try {
                        if (!$this->users->exists($org . '/' . $name)) {
                            throw new ApiException();
                        }

                        return true;
                    } catch (ApiException) {
                        return false;
                    }
                };
            }

            return Scope::all($tasks);
        };

        return array_values(array_filter($names, static fn(string $name): bool => $exists[$name]));
    }

    fun profile(int $id): User {
        return concurrently (timeout: 5) {
            $user = spawn $this->users->find($id);
            $found = $user->await();

            return $found;
        };
    }

    fun names(int $first, int $second): int {
        $count = 0;
        concurrently (timeout: 1.5) {
            spawn $this->users->find($first);
            $count += 2;
        }
        $tasks = concurrently {
            return [$second => spawn $this->users->find($second)];
        };

        return $count + \count($tasks);
    }
}
