namespace Tequila\Reflection;

final readonly class AttributeReader
{
    /**
     * @template ClassType of object
     * @template EnumType of \UnitEnum
     * @param ReflectorInterface<ClassType, EnumType> $reflector
     */
    public function __construct(private ReflectorInterface $reflector)
    {
    }

    /**
     * @param $className FQN of a class we look for attributes in
     */
    public function allFromClass(class $className): array<object>
    {
        return array_map(
            self::attributeInstance(...),
            $this->reflector->reflect($className)->getAttributes()
        );
    }

    public function allFromMethod(\ReflectionFunctionAbstract $method): array<object>
    {
        return array_map(self::attributeInstance(...), $method->getAttributes());
    }

    public function allFromProperty(\ReflectionProperty $property): array<object>
    {
        return array_map(self::attributeInstance(...), $property->getAttributes());
    }

    public function allFromParameter(\ReflectionParameter $parameter): array<object>
    {
        return array_map(self::attributeInstance(...), $parameter->getAttributes());
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function allOfTypeFromMethod<T of object>(class<T> $attributeType, \ReflectionFunctionAbstract $method): array<T>
    {
        return array_map(self::attributeInstance(...), $method->getAttributes($attributeType));
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function allOfTypeFromProperty<T of object>(class<T> $attributeType, \ReflectionProperty $property): array<T>
    {
        return array_map(self::attributeInstance(...), $property->getAttributes($attributeType));
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function allOfTypeFromParameter<T of object>(class<T> $attributeType, \ReflectionParameter $parameter): array<T>
    {
        return array_map(self::attributeInstance(...), $parameter->getAttributes($attributeType));
    }

    /**
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function allOfTypeFromClass<T of object>(class<T> $attributeType, class $className): array<T>
    {
        return array_map(
            self::attributeInstance(...),
            $this->reflector->reflect($className)->getAttributes($attributeType)
        );
    }

    /**
     * This method looks for attributes of a given type in a given class
     * or its parents and returns all attributes of the type from the first
     * class in an inheritance chain it detects them in
     *
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function allOfTypeFromClassOrParent<T of object>(class<T> $attributeType, class $className): array<T>
    {
        return array_map(
            self::attributeInstance(...),
            $this->reflectionAttributesFromClassOrParent($attributeType, $className)
        );
    }

    /**
     * This method returns all attributes of a given type from a given class
     * and all its parents
     *
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function allOfTypeFromClassAndParents<T of object>(class<T> $attributeType, class $className): array<T>
    {
        $class = $this->reflector->reflect($className);
        $attributes = [];
        do {
            array_push($attributes, ...$class->getAttributes($attributeType));
        } while ($class = $class->getParentClass());

        return array_map(self::attributeInstance(...), $attributes);
    }

    /**
     * This method returns all attributes from a given class and all its parents
     *
     * @param $className FQN of a class we look for attributes in
     */
    public function allFromClassAndParents(class $className): array<object>
    {
        $class = $this->reflector->reflect($className);
        $attributes = [];
        do {
            array_push($attributes, ...$class->getAttributes());
        } while ($class = $class->getParentClass());

        return array_map(self::attributeInstance(...), $attributes);
    }

    /**
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function firstOfTypeFromClass<T of object>(class<T> $attributeType, class $className): ?T
    {
        foreach ($this->reflector->reflect($className)->getAttributes($attributeType) as $attribute) {
            return $attribute->newInstance();
        }

        return null;
    }

    /**
     * This method looks for a first appearance of an attribute of a given
     * type in a given class or its parents
     *
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function firstOfTypeFromClassOrParent<T of object>(class<T> $attributeType, class $className): ?T
    {
        $attribute = $this->reflectionAttributesFromClassOrParent($attributeType, $className)[0] ?? null;

        return $attribute?->newInstance();
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function firstOfTypeFromMethod<T of object>(class<T> $attributeType, \ReflectionFunctionAbstract $method): ?T
    {
        return $this->allOfTypeFromMethod($attributeType, $method)[0] ?? null;
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function firstOfTypeFromMethodOrParent<T of object>(class<T> $attributeType, \ReflectionMethod $method): ?T
    {
        $class = $method->getDeclaringClass();
        $methodName = $method->getName();
        while (null === $attribute = $this->firstOfTypeFromMethod($attributeType, $method)) {
            $class = $class->getParentClass();
            if (false === $class) {
                return null;
            }

            if (!$class->hasMethod($methodName)) {
                return null;
            }

            $parentMethod = $class->getMethod($methodName);
            if ($parentMethod->isPrivate()) {
                return null;
            }
            $method = $parentMethod;
        }

        return $attribute;
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function firstOfTypeFromProperty<T of object>(class<T> $attributeType, \ReflectionProperty $property): ?T
    {
        return $this->allOfTypeFromProperty($attributeType, $property)[0] ?? null;
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function firstOfTypeFromPropertyOrParent<T of object>(class<T> $attributeType, \ReflectionProperty $property): ?T
    {
        $class = $property->getDeclaringClass();
        $propertyName = $property->getName();
        while (null === $attribute = $this->firstOfTypeFromProperty($attributeType, $property)) {
            $class = $class->getParentClass();
            if (false === $class) {
                return null;
            }

            if (!$class->hasProperty($propertyName)) {
                return null;
            }

            $parentProperty = $class->getProperty($propertyName);
            if ($parentProperty->isPrivate()) {
                return null;
            }
            $property = $parentProperty;
        }

        return $attribute;
    }

    /**
     * @param $attributeType FQN of an attribute class
     */
    public function firstOfTypeFromParameter<T of object>(class<T> $attributeType, \ReflectionParameter $parameter): ?T
    {
        return $this->allOfTypeFromParameter($attributeType, $parameter)[0] ?? null;
    }

    /**
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    private function reflectionAttributesFromClassOrParent<T of object>(class<T> $attributeType, class $className): array<\ReflectionAttribute<T>>
    {
        $class = $this->reflector->reflect($className);
        do {
            $attributes = $class->getAttributes($attributeType);
            if ($attributes) {
                return $attributes;
            }
        } while ($class = $class->getParentClass());

        return [];
    }

    private static function attributeInstance<T of object>(\ReflectionAttribute<T> $attribute): T
    {
        return $attribute->newInstance();
    }
}
