namespace App;

use Closure;

type   UserMap = map<Uuid,User>;

interface Mapper<in TIn, out TOut>
{
    map(TIn $in): TOut;

    get(Uuid $id):?TOut;
}

final class Box<T of object = object> implements \IteratorAggregate<int, T>
{
    private readonly map<string, list<Event<T>>> $streams;
    public list<T> $items = [];
    private bytes $digest;

    __construct(
        private readonly class<T> $itemClass,
        private readonly (string, int) $pair,
        private readonly ?list<T> $maybe = null,
        Closure(T, int): bool $pred = null,
        list<T>|null $alt = null,
        string|list<int> $either = '',
        T ...$rest,
    ) {
        $this->digest = (bytes)random_bytes(16);
    }

    first(list<T> $items): ?T {
        return $items[0] ?? null;
    }

    request(Closure(string, int=): void $log):Closure(string, string...): (int, string) {
        return static fn(string $stdin, string ...$args): array => [0, $stdin];
    }

    check(mixed $x): bool {
        if (is_array($x) && array_is_list($x)) {
            return true;
        }
        if ($x instanceof User) {
            return true;
        }
        $z = $x instanceof Money ? $x : null;
        return $z === null;
    }

    public static function of<U>(list<U> $rows): Box<U> {
        $id = fn<V>(V $v): V => $v;
        $box = new Box<U>(Repo::class, ['a', 1]);
        $first = first<User>($rows);
        $x = $box->get<Address>(Uuid::nil())->map<User>(fn(Address $a): User => $a->user);
        $y = Collection::of<User>($rows);
        return $box;
    }
}

function first<T>(list<T> $items): ?T {
    return $items[0] ?? null;
}
