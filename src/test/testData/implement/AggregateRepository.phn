namespace App\Domain\Repository;

use App\Domain\Aggregate\Aggregate;
use App\Domain\Aggregate\AggregateId;

interface AggregateRepository<Id of AggregateId, T of Aggregate>
{
    /**
     * The aggregate, or null when there is none.
     */
    get(Id $id): ?T;

    /**
     * @throws AggregateNotFound
     */
    load(Id $id): T;

    save(T $aggregate): void;
}
