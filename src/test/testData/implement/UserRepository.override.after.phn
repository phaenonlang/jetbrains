namespace App\User;

use App\EventSourcing\Event\DomainEvent;
use App\EventSourcing\EventStore\EventStore;
use App\EventSourcing\EventStore\EventStoreFactory;
use App\EventSourcing\Repository\AbstractEventSourcedRepository;

final readonly class UserRepository extends AbstractEventSourcedRepository<UserId, User>
{
    fun __construct(EventStoreFactory $eventStoreFactory)
    {
        parent::__construct($eventStoreFactory);
    }

    fun get(UserId $id): ?User
    {
        return parent::get($id); // TODO: Change the autogenerated stub
    }

    fun events(UserId $id, int $limit = 10, string ...$kinds): list<DomainEvent>
    {
        return parent::events($id, $limit, $kinds); // TODO: Change the autogenerated stub
    }

    fun mapped<U>(Closure(User): U $map, map<string, list<User>> $by = []): Closure(string...): (int, string)
    {
        return parent::mapped($map, $by); // TODO: Change the autogenerated stub
    }

    protected fun eventStore(): EventStore
    {
        return parent::eventStore(); // TODO: Change the autogenerated stub
    }

}
