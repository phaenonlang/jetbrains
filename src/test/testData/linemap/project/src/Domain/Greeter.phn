namespace App\Domain;

final class Greeter
{
    /** The greeting for a name. */
    greet(string $name): string => 'Hello, ' . $this->upper($name) . '!';

    upper(string $s): string => strtoupper($s);

    twice(string $name): string {
        $a = $this->greet($name);
        return $a . ' ' . $a;
    }

    log(string $m): void => error_log($m, 4);
}
